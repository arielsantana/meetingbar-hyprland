# dinit user service for MeetingBar.
# Generated by install.sh — goes in $XDG_CONFIG_HOME/dinit.d (or ~/.config/dinit.d).
# Parameter reference: dinit-service(5)

type = process
command = {INSTALL_DIR}/.venv/bin/python3 {INSTALL_DIR}/daemon.py

# Equivalent of systemd's Restart=on-failure / RestartSec=10.
restart = on-failure
restart-delay = 10

# dinit has no journal; send stdout/stderr to a file instead.
log-type = file
logfile = {LOG_FILE}

# The daemon needs the Wayland session environment (WAYLAND_DISPLAY,
# XDG_RUNTIME_DIR, DBUS_SESSION_BUS_ADDRESS) to show the overlay and to
# reach GNOME Online Accounts over the session bus. A user-mode dinit
# started from inside the graphical session inherits these. If yours is
# started earlier, uncomment and point this at a file with the values:
# env-file = {ENV_FILE}
